# Copy to .env.local for local dev, and set the same keys in the Vercel project.
# Everything here is server-only — none of it is prefixed VITE_, so none of it
# reaches the browser bundle.

# Stripe
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (server)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Service role key — bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase (browser, rep portal). VITE_ vars are compiled into the bundle, so
# only the anon key belongs here — every read it makes is filtered by RLS.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Absolute origin, used for Stripe redirect URLs and product images.
SITE_URL=http://localhost:3000

# Days a commission stays pending before becoming payable. Must comfortably
# exceed the refund window.
COMMISSION_HOLD_DAYS=45

# Salt for pseudonymous visitor hashing in the events table.
EVENT_HASH_SALT=change-me

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
